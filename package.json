{
  "name": "rtl-terminal",
  "version": "1.1.0",
  "description": "Terminal web enhanced with full RTL / Arabic support - Windows exe + Linux",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build:exe:win": "pkg server.js --targets node18-win-x64 --output dist/RTL-Terminal-win-x64.exe",
    "build:exe:linux": "pkg server.js --targets node18-linux-x64 --output dist/RTL-Terminal-linux"
  },
  "pkg": {
    "assets": ["public/**/*"],
    "targets": ["node18-win-x64"],
    "outputPath": "dist"
  },
  "keywords": ["terminal", "rtl", "arabic", "bidi", "xterm", "windows", "exe"],
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "pkg": "^5.8.1"
  }
}
